using System;
class Program
{
    static void Main()
    {
        // Solicita ao usuário que insira sua idade.
        Console.WriteLine("Qual sua idade: ");
        string netflix = Console.ReadLine(); // Lê a entrada do usuário e armazena na variável 'netflix'.

        // Pergunta ao usuário se ele já assistiu a série "Amy Schumer's Parental Advisory".
        Console.WriteLine("Você já assistiu Amy Schumer's Parental Advisory?");
        string serie = Console.ReadLine().ToLower(); // Lê a entrada do usuário, converte para letras minúsculas e armazena na variável 'serie'.

        // Verifica se o usuário respondeu "sim" para ambas as perguntas.
        if (netflix == "sim" && serie == "sim") // A comparação é feita com "sim" em letras minúsculas devido ao uso de ToLower().
        {
            // Se ambas as condições forem verdadeiras, exibe que o usuário está qualificado para a vaga.
            Console.WriteLine("Você está qualificado para a vaga!");
        }
        else
        {
            // Caso contrário, exibe que o usuário não está qualificado para a vaga.
            Console.WriteLine("Você não está qualificado para a vaga!");
        }
    }
}

