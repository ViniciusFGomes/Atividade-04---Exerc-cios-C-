using System;


class Program
{

    static void Main()
    {
        // pede o número
        Console.Write("Diga um numero: ");

        // converte entrada para float
        float numero = float.Parse(Console.ReadLine());

        // verifica divisibilidade
        if (numero % 5 == 0 || numero % 3 == 0)
        {
            Console.WriteLine("O número é divisível por 5 ou 3.");
        }
        else
        {
            Console.WriteLine("O número não é divisível por 5 nem por 3.");
        }

    }
}


