using System;

class Program
{
    static void Main()
    {
        Console.Write("Você não é um robô? (sim/nao): ");
        string resposta = Console.ReadLine();

        // Converte a resposta para minúsculas e verifica se NÃO é verdadeira
        bool ehHumano = resposta.Equals("sim", StringComparison.OrdinalIgnoreCase);

        if (!ehHumano)
        {
            Console.WriteLine("Por favor, prove que você não é um robô");
        }
    }
}
